
---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Development, automation, and life.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Automating Cats</title>
  </head>

  <body>
    <div class="container">
      <header>
        <a href="/" class="logo">
          Automating Cats<span>.</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/blog">Journal</a>
          <a href="/#about">About</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Automating Cats</p>
        <p>Built with Astro. Written with curiosity.</p>
      </footer>
    </div>
  </body>
</html>

