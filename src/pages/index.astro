---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { categories, getCategoryUrl } from "..//lib/categories";

const siteName = "Automating Cats";

const recentPosts = (await getCollection(
  'blog',
  ({ data }) => !data.draft
))
  .sort((a, b) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
 )
  .slice(0, 3);

---

<BaseLayout
  title="Home"
  description="My journey through development, automation, and life."
>
  <!-- Hero Section -->
  <section class="hero">
    <p class="eyebrow">DEVELOPMENT / AUTOMATION / LIFE</p>

    <h1>Learning in public<span>.</span></h1>

    <p class="intro">
      Automating what I can. Learning what I can't.
      Writing about everything in between.
    </p>

    <a href="#topics" class="explore">
      Explore the journal →
    </a>
  </section>

  <!-- Categories Section -->
  <section id="topics" class="topics">
    <h2>What you'll find here</h2>
    <div class="category-grid">
          {categories.map((category) => (
            <article class="category">
              <span class="category-icon">{category.icon}</span>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
            </article>
          ))}
    </div>



  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <h2>A little about this journal</h2>

    <p>
      This is a space to document what I'm learning,
      share the challenges I encounter, and reflect
      on the things that matter along the way.
    </p>
  </section>

  <!--Latest Writing Section -->
  <<section id="lastest" class="latest-writing">
    <div class="section-heading">
      <h2>Latest Writing</h2>
      <a href="/blog/">View all writing</a>
    </div>

    {recentPosts.length > 0 ? (
    <div class="recent-posts">
      {recentPosts.map((post) => (
      <PostCard post={post} />
      ))}
    </div>
    ) : (
    <p>New journal entries are coming soon</p>
    )}
  </section>
</BaseLayout>

