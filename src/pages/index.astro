
---
const siteName = "Automating Cats";

const categories = [
  {
    title: "Development",
    description: "Learning to code, solving problems, and documenting the journey.",
    icon: "⌘",
  },
  {
    title: "Projects",
    description: "Building tools, experimenting with technology, and sharing results.",
    icon: "◈",
  },
  {
    title: "Life",
    description: "Thoughts, experiences, and lessons beyond the keyboard.",
    icon: "✎",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A personal journal about development, automation, and life."
    />
    <title>{siteName} | Development & Life</title>
  </head>

  <body>
    <div class="container">
      <header>
        <a href="/" class="logo">{siteName}<span>.</span></a>

        <nav aria-label="Main navigation">
          <a href="#topics">Explore</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="eyebrow">DEVELOPMENT / AUTOMATION / LIFE</p>

          <h1>My development journey<span>.</span></h1>

          <p class="intro">
            Automating what I can. Learning what I can't.
            Writing about everything in between.
          </p>

          <a href="#topics" class="explore">Explore the journal →</a>
        </section>

        <section id="topics" class="topics">
          <h2>What you'll find here</h2>

          <div class="category-grid">
            {categories.map((category) => (
              <article class="category">
                <span class="category-icon">{category.icon}</span>
                <h3>{category.title}</h3>
                <p>{category.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="about" class="about">
          <h2>A little about this journal</h2>
          <p>
            This is a space to document what I'm learning,
            share the challenges I encounter, and reflect
            on the things that matter along the way.
          </p>
        </section>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Automating Cats</p>
        <p>Built with Astro. Written with curiosity.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: system-ui, -apple-system, sans-serif;
    background: #10151d;
    color: #f0f3f8;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 28px;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
    border-bottom: 1px solid #303947;
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 750;
  }

  .logo span,
  h1 span {
    color: #8bb9dc;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #b3bfca;
  }

  nav a:hover,
  .explore:hover {
    color: white;
  }

  .hero {
    padding: 130px 0 150px;
  }

  .eyebrow {
    color: #8bb9dc;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin: 24px 0;
  }

  .intro {
    color: #b3bfca;
    font-size: 1.3rem;
    max-width: 580px;
  }

  .explore {
    display: inline-block;
    color: #8bb9dc;
    font-weight: 600;
    margin-top: 24px;
  }

  .topics {
    padding: 50px 0 110px;
    border-top: 1px solid #303947;
  }

  h2 {
    font-size: 1.8rem;
    margin-bottom: 30px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .category {
    border: 1px solid #303947;
    border-radius: 12px;
    background: #171e28;
    padding: 30px;
  }

  .category-icon {
    color: #8bb9dc;
    font-size: 1.8rem;
  }

  .category h3 {
    margin: 20px 0 8px;
  }

  .category p,
  .about p {
    color: #b3bfca;
  }

  .about {
    max-width: 690px;
    padding: 30px 0 110px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid #303947;
    padding: 24px 0;
    color: #8c99a7;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .hero {
      padding: 85px 0;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    header {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>

