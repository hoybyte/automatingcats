
---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection(
  "blog",
  ({ data }) => !data.draft
)).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Journal"
  description="Articles about development, automation, projects, and life."
>
  <section class="journal-header">
    <p class="eyebrow">THE JOURNAL</p>
    <h1>Writing & Reflections<span>.</span></h1>
    <p class="intro">
      Notes from my development journey, projects,
      troubleshooting experiences, and life.
    </p>
  </section>

  <section class="journal-list">
    {posts.length === 0 ? (
      <p>No published articles yet.</p>
    ) : (
      posts.map((post) => (
        <article class="journal-entry">
          <div class="entry-meta">
            <span>{post.data.category}</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(
                "en-US",
                {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                }
              )}
            </time>
          </div>

          <h2>
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </h2>

          <p>{post.data.description}</p>

          <a class="read-more" href={`/blog/${post.id}/`}>
            Read article →
          </a>
        </article>
      ))
    )}
  </section>
</BaseLayout>

